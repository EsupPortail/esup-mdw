<configuration>

	<!-- increases performances for jul -->
	<contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
		<resetJUL>true</resetJUL>
	</contextListener>

	<include resource="org/springframework/boot/logging/logback/defaults.xml" />

	<springProperty scope="context" name="LOGS_PATH" source="logging.file.path" defaultValue="logs" />
	<springProperty scope="context" name="APP_URL" source="app.url" defaultValue="" />
	<springProperty scope="context" name="SMTP_HOST" source="spring.mail.host" defaultValue="" />
	<springProperty scope="context" name="SMTP_PORT" source="spring.mail.port" defaultValue="25" />
	<springProperty scope="context" name="MAIL_FROM" source="mail.from" defaultValue="" />
	<springProperty scope="context" name="MAIL_TO" source="mail.to" defaultValue="" />
	<springProperty scope="context" name="MAIL_START_DISABLING" source="mail.startDisabling" defaultValue="00:15" />
	<springProperty scope="context" name="MAIL_STOP_DISABLING" source="mail.stopDisabling" defaultValue="00:45" />

	<property name="defaultPattern" value="%date{HH:mm:ss.SSS} [%thread] %-5level %mdc{username} %logger - %message%n" />

	<appender name="consoleAppender" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>${defaultPattern}</pattern>
		</encoder>
	</appender>

	<appender name="fileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOGS_PATH}/mondossierweb.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOGS_PATH}/mondossierweb-%d.%i.log</fileNamePattern>
			<maxFileSize>1MB</maxFileSize>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>${defaultPattern}</pattern>
		</encoder>
	</appender>

	<appender name="securityFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOGS_PATH}/mondossierweb-security.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOGS_PATH}/mondossierweb-security-%d.%i.log</fileNamePattern>
			<maxFileSize>1MB</maxFileSize>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>${defaultPattern}</pattern>
		</encoder>
	</appender>

	<!-- Regroupe les mails d'erreur pour éviter le spam -->
	<appender name="mailAppender" class="fr.univlorraine.tools.logback.GroupEventsSMTPAppender">
		<!-- Délai des mails en secondes (1 par défaut) -->
		<mailDelaySeconds>60</mailDelaySeconds>

		<smtpHost>${SMTP_HOST}</smtpHost>
		<smtpPort>${SMTP_PORT}</smtpPort>
		<from>${MAIL_FROM}</from>
		<to>${MAIL_TO}</to>
		<subject>[mondossierweb] Logback Message from ${APP_URL}</subject>
		<asynchronousSending>false</asynchronousSending>

		<filter class="fr.univlorraine.tools.logback.TimeFilter">
			<startDisabling>${MAIL_START_DISABLING}</startDisabling>
			<stopDisabling>${MAIL_STOP_DISABLING}</stopDisabling>
		</filter>

		<layout class="ch.qos.logback.classic.html.HTMLLayout" />
	</appender>

	<springProfile name="debug">
		<logger name="fr.univlorraine.mondossierweb" level="debug">
			<appender-ref ref="consoleAppender" />
			<appender-ref ref="fileAppender" />
		</logger>
	</springProfile>

	<springProfile name="!debug">
		<logger name="fr.univlorraine.mondossierweb" level="error">
			<appender-ref ref="fileAppender" />
			<appender-ref ref="mailAppender" />
			<appender-ref ref="consoleAppender" />
		</logger>
	</springProfile>

	<logger name="fr.univlorraine.mondossierweb.security" level="info" additivity="false">
		<appender-ref ref="securityFileAppender" />
	</logger>

	<!-- Messages de démarrage visibles en console (Starting/Started Application, Tomcat started on port) -->
	<logger name="fr.univlorraine.mondossierweb.Application" level="info" additivity="false">
		<appender-ref ref="consoleAppender" />
		<appender-ref ref="fileAppender" />
	</logger>
	<logger name="org.springframework.boot.web.embedded.tomcat.TomcatWebServer" level="info" additivity="false">
		<appender-ref ref="consoleAppender" />
		<appender-ref ref="fileAppender" />
	</logger>
	<logger name="org.flywaydb.core" level="info" additivity="false">
		<appender-ref ref="consoleAppender" />
		<appender-ref ref="fileAppender" />
	</logger>

	<root level="warn">
		<appender-ref ref="fileAppender" />
	</root>

	<logger name="org.springframework" level="warn" />

	<logger name="com.vaadin" level="error" />

	<!-- Erreurs des listeners UI (popup d'erreur Vaadin) : loguées en console+fichier, sans mail -->
	<logger name="com.vaadin.flow.server.DefaultErrorHandler" level="error" additivity="false">
		<appender-ref ref="consoleAppender" />
		<appender-ref ref="fileAppender" />
	</logger>

	<!-- Ne mail pas les erreurs atmosphere (push) -->
	<logger name="org.atmosphere" level="off" />

	<logger name="org.apache.catalina.core.ContainerBase" level="warn" additivity="false">
		<appender-ref ref="consoleAppender" />
		<appender-ref ref="fileAppender" />
	</logger>

</configuration>
